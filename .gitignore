# ===== Dependencies =====
node_modules/

# pnpm 内容存储（全局 pnpm 的包文件所在，体积大且与本机绑定，切勿提交）
.pnpm-store/

# ===== Build outputs =====
dist/
dist-ssr/
*.local

# ===== Logs =====
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ===== Environment files =====
# 保留 .env.development / .env.production（可提交），忽略本地私密配置
.env.local
.env.*.local

# ===== Workspace 成员内的游离锁文件 =====
# pnpm workspace 以根目录 pnpm-lock.yaml 为唯一依据，成员内的锁文件是冗余的
apps/*/package-lock.json
apps/*/pnpm-lock.yaml
apps/main/*/pnpm-lock.yaml
packages/*/pnpm-lock.yaml

# ===== Editor / IDE =====
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== OS files =====
.DS_Store
Thumbs.db
desktop.ini
